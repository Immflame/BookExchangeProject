<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="aidar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)" />
            <column name="role" type="VARCHAR(20)" defaultValue="USER"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="aidar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="locations"/>
            </not>
        </preConditions>
        <createTable tableName="locations">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="aidar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="books"/>
            </not>
        </preConditions>
        <createTable tableName="books">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)" />
            <column name="author" type="VARCHAR(255)" />
            <column name="description" type="TEXT"/>
            <column name="location_id" type="INT"/>
            <column name="user_id" type="INT"/>
            <column name="genre" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="AVAILABLE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="books" baseColumnNames="location_id"
                                 referencedTableName="locations" referencedColumnNames="id" constraintName="fk_books_location_id"/>
        <addForeignKeyConstraint baseTableName="books" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id" constraintName="fk_books_user_id"/>
    </changeSet>

    <changeSet id="4" author="aidar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="exchanges"/>
            </not>
        </preConditions>
        <createTable tableName="exchanges">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="book1_id" type="INT"/>
            <column name="book2_id" type="INT"/>
            <column name="user1_id" type="INT"/>
            <column name="user2_id" type="INT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING"/>
            <column name="exchange_date" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="exchanges" baseColumnNames="book1_id"
                                 referencedTableName="books" referencedColumnNames="id" constraintName="fk_exchanges_book1_id"/>
        <addForeignKeyConstraint baseTableName="exchanges" baseColumnNames="book2_id"
                                 referencedTableName="books" referencedColumnNames="id" constraintName="fk_exchanges_book2_id"/>
        <addForeignKeyConstraint baseTableName="exchanges" baseColumnNames="user1_id"
                                 referencedTableName="users" referencedColumnNames="id" constraintName="fk_exchanges_user1_id"/>
        <addForeignKeyConstraint baseTableName="exchanges" baseColumnNames="user2_id"
                                 referencedTableName="users" referencedColumnNames="id" constraintName="fk_exchanges_user2_id"/>
    </changeSet>

    <changeSet id="5" author="aidar">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="reviews"/>
            </not>
        </preConditions>
        <createTable tableName="reviews">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reviewer_id" type="INT"/>
            <column name="reviewee_id" type="INT"/>
            <column name="rating" type="INT"/>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="reviews" baseColumnNames="reviewer_id"
                                 referencedTableName="users" referencedColumnNames="id" constraintName="fk_reviewer_user_id"/>
        <addForeignKeyConstraint baseTableName="reviews" baseColumnNames="reviewee_id"
                                 referencedTableName="users" referencedColumnNames="id" constraintName="fk_reviewee_user_id"/>
    </changeSet>
</databaseChangeLog>